# DEVELOPMENT: локальная проверка backend. Production требует HTTPS + webhook.
ENV=development
# Выключен по умолчанию. Для отдельной локальной проверки API включите явно.
DEV_MODE=false
# ID тестового клиента. Для локальных ролей: start.bat --local --local-role owner.
DEV_USER_TG_ID=900000001
# Без связи с Telegram по умолчанию. setup_telegram.py включает реального бота.
BOT_ENABLED=false
# Токен от @BotFather. При BOT_ENABLED=true обязателен. Никому не отправляйте.
BOT_TOKEN=
# Только Telegram Bot API через HTTP/SOCKS5 прокси вашего VPN.
# Пусто — прямое соединение. Пример с условным портом: http://127.0.0.1:7890
BOT_PROXY_URL=
# Автозаполнение Taobao/Tmall, 1688 и Goofish через платный OneBound API.
# Включается только после получения собственных key + secret и доступа к item_get.
ONEBOUND_API_KEY=
ONEBOUND_API_SECRET=
# polling локально, webhook на сервере.
BOT_MODE=polling
# Для бота нужен HTTPS. start.bat обновляет адрес временного Cloudflare-туннеля.
WEBAPP_URL=http://127.0.0.1:8000
# Необязательно: для ручного ngrok-туннеля через scripts/ngrok_tunnel.py.
# Если пусто, скрипт запросит токен скрыто на вашем компьютере.
NGROK_AUTHTOKEN=
# Относительный SQLite путь считается от корня проекта независимо от cwd.
# PostgreSQL: postgresql+asyncpg://USER:PASSWORD@HOST:5432/taoji
DATABASE_URL=sqlite+aiosqlite:///./data/taoji.db
# Только положительные числовые Telegram ID через запятую, не @username.
OWNER_IDS=
MANAGER_IDS=
# Сгенерируйте secrets.token_urlsafe(48); отдельный секрет, не токен бота.
JWT_SECRET=
JWT_TTL_MINUTES=15
# 24 часа. При истечении требуется заново открыть Mini App в Telegram.
INIT_DATA_MAX_AGE_SECONDS=86400
# Для webhook: разные случайные секреты из A-Z a-z 0-9 _ -, длина 32–128.
WEBHOOK_PATH_SECRET=
WEBHOOK_SECRET_TOKEN=
# Локально не открывайте сервер в LAN: публичный доступ только через туннель.
HOST=127.0.0.1
# Доверенные прокси для HTTPS/IP. Не используйте *.
FORWARDED_ALLOW_IPS=127.0.0.1,::1
PORT=8000
# Эти контакты публичны и отдаются клиенту через /config.
OWNER_USERNAME=ZontikTech
MANAGER_USERNAME=TaojiBuy
CHANNEL_USERNAME=taojicn
# Группа/канал для отзывов: клиент открывает её кнопкой «Оставить отзыв».
REVIEW_USERNAME=taojiotziv
# Страховка: процент от стоимости товара в рублях. Доступна только на тарифах,
# у которых в админке включён флажок «Страховка груза доступна».
INSURANCE_PERCENT=10
# Обрешётка: плата за одну коробку в рублях. Количество коробок указывает клиент.
PACKING_FEE_RUB=299
# Фотоотчёт на складе: фиксированная плата за заказ в рублях.
PHOTO_REPORT_FEE_RUB=150

TRACKING_REFRESH_HOURS=1
# Добропост: публичный ключ трекинг-API (взят из JS страницы трекинга) и адреса API.
DOBROPOST_API_KEY=b4538f528e7a957bd734fdeeab12d143
DOBROPOST_API_BASE=https://api.dobropost.com/api/tracking
DOBROPOST_PROXY_BASE=https://api-dobropost-com.translate.goog/api/tracking
# Необязательный шаблон страницы трекинга с {track}; по умолчанию используется API.
DOBROPOST_TRACKING_URL=

# Ежедневный бэкап SQLite в data/backups (последние N файлов).
BACKUP_ENABLED=true
BACKUP_KEEP=7

# Напоминание об отзыве: одно сообщение через N часов после «Доставлен».
REVIEW_REMINDER_ENABLED=true
REVIEW_REMINDER_HOURS=48
