# Создаётся отдельно от локального .env через scripts/setup_production.py.
# После создания храните вне Git, права доступа 600 на сервере.
DOMAIN=
ACME_EMAIL=
ENV=production
DEV_MODE=false
BOT_ENABLED=true
BOT_MODE=webhook
BOT_TOKEN=
# Обычно сервер подключается напрямую. Задавайте только при необходимости.
BOT_PROXY_URL=
# Необязательный источник данных товара: собственные ключи OneBound API.
ONEBOUND_API_KEY=
ONEBOUND_API_SECRET=
WEBAPP_URL=
OWNER_IDS=
MANAGER_IDS=
JWT_SECRET=
WEBHOOK_PATH_SECRET=
WEBHOOK_SECRET_TOKEN=
# Эти значения генерирует мастер; не публикуйте.
POSTGRES_PASSWORD=
DATABASE_URL=
HOST=0.0.0.0
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1,::1,172.30.0.2
OWNER_USERNAME=ZontikTech
MANAGER_USERNAME=TaojiBuy
CHANNEL_USERNAME=taojicn
