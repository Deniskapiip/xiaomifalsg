# Bothost, вариант без Node-сборки в контейнере.
# Нужен, если сборщик Bothost падает по памяти или вы деплоите ZIP-архивом,
# в котором уже лежит собранный frontend/dist.
#
# Как использовать: включите «Использовать собственный Dockerfile» и положите
# этот файл в корень репозитория под именем Dockerfile (заменив корневой).
# Перед этим соберите интерфейс локально: cd frontend; npm.cmd ci; npm.cmd run build.
# В .dockerignore уже есть строка !frontend/dist, поэтому готовый dist попадает в контекст.
FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    HOST=0.0.0.0

WORKDIR /srv/taoji-cargo
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY backend/ ./backend/
COPY scripts/ ./scripts/
COPY frontend/dist/ ./frontend/dist/
COPY deploy/bothost-entrypoint.sh /usr/local/bin/bothost-entrypoint
RUN chmod 755 /usr/local/bin/bothost-entrypoint \
    && mkdir -p /srv/taoji-cargo/data /srv/taoji-cargo/backups

WORKDIR /srv/taoji-cargo/backend
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/bothost-entrypoint"]
